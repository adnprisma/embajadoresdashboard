{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // supabase/functions/: Deno, no Node — `Deno.serve`, imports `npm:...`,
  // sin tipos de Node. Corre y se despliega aparte (runtime de Supabase),
  // nunca lo compila Next — incluirlo aquí tumbaba `next build` con
  // errores que no son de este proyecto.
  "exclude": ["node_modules", "supabase/functions"]
}
